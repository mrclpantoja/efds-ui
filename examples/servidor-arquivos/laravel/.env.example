# Valores ficticios. Copie as chaves que precisar para o .env da sua aplicacao Laravel.

# Disco do config/filesystems.php: local ou s3
FILES_DISK=local
FILES_ROUTE_PREFIX=api/arquivos

FILES_MAX_UPLOAD_BYTES=52428800
FILES_ACCEPT=
FILES_TRASH_RETENTION_DAYS=30
FILES_MAX_VERSIONS=20
FILES_SIGNED_URL_TTL=300
FILES_AUDIT_CHANNEL=

# --- Somente com FILES_DISK=s3 (credenciais pelo papel IAM; evite chaves no .env) ---
FILES_S3_VERSIONING=auto
FILES_S3_PURGE_VERSIONS=false
FILES_DIRECT_UPLOAD=false
FILES_REDIRECT_DOWNLOADS=false

# Em config/filesystems.php, o disco "s3" usa as variaveis padrao do Laravel:
AWS_DEFAULT_REGION=sa-east-1
AWS_BUCKET=bucket-de-exemplo
# AWS_ENDPOINT=http://127.0.0.1:9000
# AWS_USE_PATH_STYLE_ENDPOINT=true
