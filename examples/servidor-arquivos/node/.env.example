# Valores fictícios. Copie para .env (que NÃO deve ir para o Git) e ajuste.
PORT=3000
HOST=127.0.0.1
FILES_BASE_PATH=/api/arquivos

# Tokens Bearer de exemplo -> usuário e permissões por pasta (r = ler, w = gravar, d = excluir).
# Troque por sua autenticação real (sessão, JWT, SSO). Gere tokens longos e aleatórios.
FILES_TOKENS={"troque-por-um-token-longo-e-aleatorio":{"user":"usuario-exemplo","acl":{"/":"rwd"}}}

# Driver: fs (disco local) ou s3
STORAGE_DRIVER=fs
FILES_ROOT=./storage

# Limites e política
MAX_UPLOAD_BYTES=52428800
ACCEPT=
TRASH_RETENTION_DAYS=30
MAX_VERSIONS=20
SIGNED_URL_TTL=300

# --- Somente com STORAGE_DRIVER=s3 (credenciais pela cadeia padrão da AWS: papel IAM, nunca no código) ---
S3_BUCKET=bucket-de-exemplo
S3_REGION=sa-east-1
S3_PREFIX=arquivos/
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_FORCE_PATH_STYLE=true
S3_VERSIONING=auto
S3_SSE=AES256
S3_DIRECT_UPLOAD=false
S3_REDIRECT_DOWNLOADS=false
S3_PURGE_VERSIONS=false
