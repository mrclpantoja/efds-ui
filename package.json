{
  "name": "efds-ui",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "description": "efDS.ui - Empresarial Framework Design System UI",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @efds-ui/playground dev",
    "docs:dev": "pnpm --filter @efds-ui/docs dev",
    "docs:check": "pnpm --filter @efds-ui/docs check:visual",
    "tokens": "node scripts/build-tokens.ts",
    "tokens:check": "node scripts/build-tokens.ts --check",
    "prebuild": "pnpm tokens",
    "build": "pnpm -r build",
    "pack:check": "node scripts/check-pack.ts",
    "templates:keygen": "node scripts/templates/keygen.ts",
    "templates:issue": "node scripts/templates/issue.ts",
    "templates:vendor": "node scripts/templates/vendor.ts",
    "templates:pack": "node scripts/templates/pack.ts",
    "templates:dev": "pnpm --filter @efds-ui/template-license exec vite --config vite.dev.config.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "templates:site": "node scripts/templates/site.ts",
    "site:build": "pnpm build && pnpm templates:vendor && pnpm templates:site"
  },
  "devDependencies": {
    "@efds-ui/eslint-config": "workspace:*",
    "@efds-ui/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
