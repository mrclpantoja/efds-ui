{
  "name": "eds-ui",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "description": "eDS.ui - Empresarial Design System UI Framework",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @eds-ui/playground dev",
    "docs:dev": "pnpm --filter @eds-ui/docs dev",
    "docs:check": "pnpm --filter @eds-ui/docs check:visual",
    "tokens": "node scripts/build-tokens.ts",
    "tokens:check": "node scripts/build-tokens.ts --check",
    "prebuild": "pnpm tokens",
    "build": "pnpm -r build",
    "pack:check": "node scripts/check-pack.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eds-ui/eslint-config": "workspace:*",
    "@eds-ui/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
