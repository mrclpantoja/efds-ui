{
  "name": "@efds-ui/behavior",
  "version": "1.1.0",
  "license": "MIT",
  "author": "Marcelo Pantoja",
  "homepage": "https://efds-ui.com.br",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrclpantoja/efds-ui.git",
    "directory": "packages/behavior"
  },
  "bugs": {
    "url": "https://github.com/mrclpantoja/efds-ui/issues"
  },
  "type": "module",
  "description": "Comportamento interativo do efDS.ui em JavaScript puro, para quem usa só HTML (PHP, Java, .NET, Vue, Angular).",
  "keywords": [
    "design-system",
    "accessibility",
    "vanilla-js",
    "eds"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/eds-behavior.js",
  "jsdelivr": "./dist/eds-behavior.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./export": {
      "development": "./src/export-entry.ts",
      "types": "./dist/export-entry.d.ts",
      "default": "./dist/export-entry.js"
    },
    "./export/*": {
      "development": "./src/export/formats/*.ts",
      "types": "./dist/export/formats/*.d.ts",
      "default": "./dist/export/formats/*.js"
    },
    "./mask": {
      "development": "./src/mask-entry.ts",
      "types": "./dist/mask-entry.d.ts",
      "default": "./dist/mask-entry.js"
    },
    "./validate": {
      "development": "./src/validate-entry.ts",
      "types": "./dist/validate-entry.d.ts",
      "default": "./dist/validate-entry.js"
    },
    "./fields": {
      "development": "./src/fields-entry.ts",
      "types": "./dist/fields-entry.d.ts",
      "default": "./dist/fields-entry.js"
    },
    "./format": {
      "development": "./src/format-entry.ts",
      "types": "./dist/format-entry.d.ts",
      "default": "./dist/format-entry.js"
    },
    "./theme": {
      "development": "./src/theme-entry.ts",
      "types": "./dist/theme-entry.d.ts",
      "default": "./dist/theme-entry.js"
    },
    "./internal": {
      "development": "./src/internal-entry.ts",
      "types": "./dist/internal-entry.d.ts",
      "default": "./dist/internal-entry.js"
    },
    "./image": {
      "development": "./src/image-entry.ts",
      "types": "./dist/image-entry.d.ts",
      "default": "./dist/image-entry.js"
    },
    "./files": {
      "development": "./src/files-entry.ts",
      "types": "./dist/files-entry.d.ts",
      "default": "./dist/files-entry.js"
    },
    "./eds-behavior.js": "./dist/eds-behavior.js",
    "./eds-behavior-core.js": "./dist/eds-behavior-core.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.iife.config.ts && vite build --config vite.iife-core.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@efds-ui/typescript-config": "workspace:*",
    "@efds-ui/vitest-config": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/user-event": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./export": {
        "types": "./dist/export-entry.d.ts",
        "default": "./dist/export-entry.js"
      },
      "./export/*": {
        "types": "./dist/export/formats/*.d.ts",
        "default": "./dist/export/formats/*.js"
      },
      "./mask": {
        "types": "./dist/mask-entry.d.ts",
        "default": "./dist/mask-entry.js"
      },
      "./internal": {
        "types": "./dist/internal-entry.d.ts",
        "default": "./dist/internal-entry.js"
      },
      "./theme": {
        "types": "./dist/theme-entry.d.ts",
        "default": "./dist/theme-entry.js"
      },
      "./validate": {
        "types": "./dist/validate-entry.d.ts",
        "default": "./dist/validate-entry.js"
      },
      "./fields": {
        "types": "./dist/fields-entry.d.ts",
        "default": "./dist/fields-entry.js"
      },
      "./format": {
        "types": "./dist/format-entry.d.ts",
        "default": "./dist/format-entry.js"
      },
      "./image": {
        "types": "./dist/image-entry.d.ts",
        "default": "./dist/image-entry.js"
      },
      "./files": {
        "types": "./dist/files-entry.d.ts",
        "default": "./dist/files-entry.js"
      },
      "./eds-behavior.js": "./dist/eds-behavior.js",
      "./eds-behavior-core.js": "./dist/eds-behavior-core.js",
      "./package.json": "./package.json"
    }
  }
}
