{
  "name": "@eds-ui/behavior",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Comportamento interativo do eDS.ui em JavaScript puro, para quem usa só HTML (PHP, Java, .NET, Vue, Angular).",
  "keywords": [
    "design-system",
    "accessibility",
    "vanilla-js",
    "eds"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/eds-behavior.js",
  "jsdelivr": "./dist/eds-behavior.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./export": {
      "development": "./src/export-entry.ts",
      "types": "./dist/export-entry.d.ts",
      "default": "./dist/export-entry.js"
    },
    "./export/*": {
      "development": "./src/export/formats/*.ts",
      "types": "./dist/export/formats/*.d.ts",
      "default": "./dist/export/formats/*.js"
    },
    "./mask": {
      "development": "./src/mask-entry.ts",
      "types": "./dist/mask-entry.d.ts",
      "default": "./dist/mask-entry.js"
    },
    "./balloon": {
      "development": "./src/balloon-entry.ts",
      "types": "./dist/balloon-entry.d.ts",
      "default": "./dist/balloon-entry.js"
    },
    "./eds-behavior.js": "./dist/eds-behavior.js",
    "./eds-behavior-core.js": "./dist/eds-behavior-core.js"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.iife.config.ts && vite build --config vite.iife-core.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eds-ui/typescript-config": "workspace:*",
    "@eds-ui/vitest-config": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/user-event": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./export": {
        "types": "./dist/export-entry.d.ts",
        "default": "./dist/export-entry.js"
      },
      "./export/*": {
        "types": "./dist/export/formats/*.d.ts",
        "default": "./dist/export/formats/*.js"
      },
      "./mask": {
        "types": "./dist/mask-entry.d.ts",
        "default": "./dist/mask-entry.js"
      },
      "./eds-behavior.js": "./dist/eds-behavior.js",
      "./eds-behavior-core.js": "./dist/eds-behavior-core.js"
    }
  }
}
