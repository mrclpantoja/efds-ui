{
  "name": "@efds-ui/core",
  "version": "0.1.2",
  "license": "MIT",
  "author": "Marcelo Pantoja",
  "homepage": "https://efds-ui.com.br",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrclpantoja/efds-ui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/mrclpantoja/efds-ui/issues"
  },
  "type": "module",
  "description": "CSS puro do efDS.ui: tokens, base, layout e componentes.",
  "keywords": [
    "design-system",
    "css",
    "design-tokens",
    "eds"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "style": "./dist/index.css",
  "exports": {
    "./index.css": {
      "development": "./src/index.css",
      "default": "./dist/index.css"
    },
    "./tokens.css": {
      "development": "./src/tokens.css",
      "default": "./dist/tokens.css"
    },
    "./base.css": {
      "development": "./src/base.css",
      "default": "./dist/base.css"
    },
    "./layout/*.css": {
      "development": "./src/layout/*.css",
      "default": "./dist/layout/*.css"
    },
    "./components/*.css": {
      "development": "./src/components/*.css",
      "default": "./dist/components/*.css"
    }
  },
  "scripts": {
    "build": "vite build"
  },
  "devDependencies": {
    "vite": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./index.css": "./dist/index.css",
      "./tokens.css": "./dist/tokens.css",
      "./base.css": "./dist/base.css",
      "./layout/*.css": "./dist/layout/*.css",
      "./components/*.css": "./dist/components/*.css"
    }
  }
}
