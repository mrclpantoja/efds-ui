{
  "name": "@efds-ui/editor",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Marcelo Pantoja",
  "homepage": "https://efds-ui.com.br",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrclpantoja/efds-ui.git",
    "directory": "packages/editor"
  },
  "bugs": {
    "url": "https://github.com/mrclpantoja/efds-ui/issues"
  },
  "type": "module",
  "description": "Editor de conteúdo do efDS.ui (edição Básica) sobre ProseMirror: núcleo vanilla ligado por textarea[data-eds-editor], IIFE e wrapper React.",
  "keywords": [
    "design-system",
    "accessibility",
    "editor",
    "prosemirror",
    "eds"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/eds-editor.js",
  "jsdelivr": "./dist/eds-editor.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "development": "./src/react/index.ts",
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./eds-editor.js": "./dist/eds-editor.js"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.iife.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "prosemirror-commands": "catalog:",
    "prosemirror-dropcursor": "catalog:",
    "prosemirror-gapcursor": "catalog:",
    "prosemirror-history": "catalog:",
    "prosemirror-inputrules": "catalog:",
    "prosemirror-keymap": "catalog:",
    "prosemirror-model": "catalog:",
    "prosemirror-schema-list": "catalog:",
    "prosemirror-state": "catalog:",
    "prosemirror-tables": "catalog:",
    "prosemirror-transform": "catalog:",
    "prosemirror-view": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@efds-ui/typescript-config": "workspace:*",
    "@efds-ui/vitest-config": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "./eds-editor.js": "./dist/eds-editor.js"
    }
  }
}
