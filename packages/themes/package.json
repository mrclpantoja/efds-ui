{
  "name": "@efds-ui/themes",
  "version": "0.1.1",
  "license": "MIT",
  "author": "Marcelo Pantoja",
  "homepage": "https://efds-ui.com.br",
  "type": "module",
  "description": "Temas e eixos (theme, mode, density, shape) do efDS.ui.",
  "keywords": [
    "design-system",
    "css",
    "themes",
    "dark-mode",
    "eds"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "style": "./dist/index.css",
  "exports": {
    "./index.css": {
      "development": "./src/index.css",
      "default": "./dist/index.css"
    },
    "./*.css": "./dist/*.css"
  },
  "scripts": {
    "build": "vite build"
  },
  "dependencies": {
    "@efds-ui/core": "workspace:*"
  },
  "devDependencies": {
    "vite": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./index.css": "./dist/index.css",
      "./*.css": "./dist/*.css"
    }
  }
}
