{
  "$selector": "[data-mode=\"dark\"]",
  "$description": "Modo dark: passos de accent escolhidos para AA sobre superfícies escuras; text-on-action escuro",
  "color-bg-page": "{gray-950}",
  "color-bg-surface": "{gray-900}",
  "color-bg-subtle": "{gray-800}",
  "color-bg-overlay": "color-mix(in srgb, {gray-950} 70%, transparent)",
  "color-text-primary": "{gray-50}",
  "color-text-secondary": "{gray-300}",
  "color-text-muted": "{gray-400}",
  "color-text-on-action": "{gray-950}",
  "color-border-default": "{gray-700}",
  "color-border-strong": "{gray-500}",
  "color-action-primary": "{accent-400}",
  "color-action-primary-hover": "{accent-300}",
  "color-action-primary-active": "{accent-200}",
  "color-action-primary-subtle": "color-mix(in srgb, {accent-400} 12%, {gray-900})",
  "color-status-info": "{blue-500}",
  "color-status-info-subtle": "color-mix(in srgb, {blue-500} 16%, {gray-900})",
  "color-status-info-text": "{blue-300}",
  "color-status-success": "{success-500}",
  "color-status-success-subtle": "color-mix(in srgb, {success-500} 16%, {gray-900})",
  "color-status-success-text": "{success-300}",
  "color-status-warning": "{warning-500}",
  "color-status-warning-subtle": "color-mix(in srgb, {warning-500} 16%, {gray-900})",
  "color-status-warning-text": "{warning-300}",
  "color-status-danger": "{danger-500}",
  "color-status-danger-subtle": "color-mix(in srgb, {danger-500} 16%, {gray-900})",
  "color-status-danger-text": "{danger-300}",
  "color-focus-ring": "{accent-400}",
  "shadow-xs": "0 1px 2px rgb(0 0 0 / 0.40)",
  "shadow-sm": "0 1px 3px rgb(0 0 0 / 0.45), 0 1px 2px rgb(0 0 0 / 0.30)",
  "shadow-md": "0 4px 12px rgb(0 0 0 / 0.50), 0 2px 4px rgb(0 0 0 / 0.30)",
  "shadow-lg": "0 12px 32px rgb(0 0 0 / 0.55), 0 4px 8px rgb(0 0 0 / 0.35)"
}
